# Leave empty to use same-origin /api (served by FastAPI). Set to a full URL
# only if the API is hosted separately, e.g. http://localhost:8000
NUXT_PUBLIC_API_BASE=

# Clerk (from dashboard or `clerk init`)
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=
NUXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NUXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
