# API (required at Cloud Run runtime)
GOOGLE_API_KEY=
DB_URL=
DB_TOKEN=

# Search defaults
SEARCH_MAX_LISTINGS=50
SEARCH_TOP_K=10
# Reuse scraped listing sets for identical Airbnb filters (hours; 0 disables)
SEARCH_CACHE_TTL_HOURS=24
# Number of listing texts sent per Gemini embedding request
GEMINI_EMBED_BATCH_SIZE=8

# UI / Clerk secret only (publishable key lives in ui/nuxt.config.ts)
NUXT_PUBLIC_API_BASE=
NUXT_CLERK_SECRET_KEY=
